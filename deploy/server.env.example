# Copy to deploy/server.env and fill in. Read by deploy/push.sh.
# The real file is gitignored: it points at the server and the SSH key.

SERVER_HOST=              # the server's public IP or hostname
SERVER_USER=ubuntu        # the SSH user the bot runs as
SSH_KEY=~/.ssh/your_key   # path to the private key on your own machine

# Handy:
#   ./deploy/push.sh                       deploy latest code + restart
#   ssh -i "$SSH_KEY" "$SERVER_USER@$SERVER_HOST" 'sudo systemctl restart noctua-bot'
#   ssh -i "$SSH_KEY" "$SERVER_USER@$SERVER_HOST" 'tail -f /opt/noctua-bot/noctua.log'
