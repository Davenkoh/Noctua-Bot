# Telegram bot token from @BotFather (required)
BOT_TOKEN=

# Comma-separated Telegram usernames (without @) allowed to /announce
LEADER_USERNAMES=

# Usernames allowed to /resetmachines and /resetme as well. Both wipe state,
# so keep this list short. Admins count as leaders too, no need to list twice.
ADMIN_USERNAMES=

# Dry run for /poll: while this is set, a poll reaches only these handles
# instead of every registered resident. Clear it to go live.
# POLL_TEST_HANDLES=alice,bob

# Optional overrides
# TIMEZONE=Asia/Singapore
# DB_PATH=/full/path/to/noctua.db
